<UserControl x:Class="NetGuard.Desktop.Views.LogsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Activity Logs" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="The audit trail of every policy change, enforcement attempt and result, authorization decision, and service event." />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <TextBox Width="220" Margin="0,0,8,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search logs">
                <TextBox.InputBindings>
                    <KeyBinding Key="Enter" Command="{Binding SearchCommand}" />
                </TextBox.InputBindings>
            </TextBox>
            <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding From}" AutomationProperties.Name="From date" ToolTip="From" />
            <DatePicker Width="140" Margin="0,0,8,8" SelectedDate="{Binding To}" AutomationProperties.Name="To date" ToolTip="To" />
            <ComboBox Width="200" Margin="0,0,8,8" ItemsSource="{Binding Types}" SelectedItem="{Binding SelectedType}" AutomationProperties.Name="Event type" />
            <ComboBox Width="140" Margin="0,0,8,8" ItemsSource="{Binding Outcomes}" SelectedItem="{Binding SelectedOutcome}" AutomationProperties.Name="Outcome" />
            <Button Style="{DynamicResource AccentButtonStyle}" Content="Search" Command="{Binding SearchCommand}" Margin="0,0,8,8" />
            <Button Content="Clear filters" Command="{Binding ClearFiltersCommand}" Margin="0,0,8,8" />
            <Button Content="Export CSV…" Command="{Binding ExportCsvCommand}" Margin="0,0,8,8" />
            <Button Content="Export JSON…" Command="{Binding ExportJsonCommand}" Margin="0,0,8,8" />
        </WrapPanel>
        <StackPanel Grid.Row="2">
            <Border Style="{StaticResource InfoPanel}" Visibility="{Binding ApplicationFilterText, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ApplicationFilterText}" />
            </Border>
            <Border Style="{StaticResource WarningPanel}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Audit events">
            <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Width="140" Binding="{Binding Timestamp, Converter={StaticResource LocalTime}, ConverterParameter='G'}" SortMemberPath="Timestamp" />
                <DataGridTextColumn Header="Event" Width="170" Binding="{Binding Type}" />
                <DataGridTemplateColumn Header="Outcome" Width="90" SortMemberPath="Outcome">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Ellipse Width="8" Height="8" Margin="0,0,6,0" Fill="{Binding Outcome, Converter={StaticResource OutcomeBrush}}" />
                                <TextBlock Text="{Binding Outcome}" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Application" Width="140" Binding="{Binding ApplicationName}" />
                <DataGridTextColumn Header="Account" Width="140" Binding="{Binding Actor}" />
                <DataGridTextColumn Header="Message" Width="*" Binding="{Binding Message}" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,8,0,0">
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                <Button Content="Previous" Command="{Binding PreviousCommand}" Margin="0,0,8,0" />
                <Button Content="Next" Command="{Binding NextCommand}" />
            </StackPanel>
            <TextBlock Text="{Binding PageText}" VerticalAlignment="Center" Style="{StaticResource Caption}" />
        </DockPanel>
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0,12,0,0" Visibility="{Binding Selected, Converter={StaticResource NullToVisibility}}" MaxHeight="220">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Text="{Binding Selected.Message}" TextWrapping="Wrap" FontWeight="SemiBold" />
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.ExecutablePath}" TextWrapping="Wrap" Margin="0,4,0,0" />
                    <TextBox Text="{Binding SelectedDetails, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                             Margin="0,8,0,0" BorderThickness="0" Background="Transparent" Visibility="{Binding SelectedDetails, Converter={StaticResource NullToVisibility}}"
                             AutomationProperties.Name="Event details" />
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

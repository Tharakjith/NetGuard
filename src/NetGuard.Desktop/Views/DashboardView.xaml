<UserControl x:Class="NetGuard.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="0,0,12,24">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh (F5)" Command="{Binding RefreshCommand}" VerticalAlignment="Top" />
                <StackPanel>
                    <TextBlock Style="{StaticResource PageTitle}" Text="Overview" />
                    <TextBlock Style="{StaticResource PageSubtitle}"
                               Text="Live enforcement status. A restriction is shown as Enforced only after its rules were read back from Windows Defender Firewall and the firewall is active on the current network." />
                </StackPanel>
            </DockPanel>

            <Border Style="{StaticResource WarningPanel}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>

            <!-- KPIs -->
            <UniformGrid Columns="5" Margin="0,0,0,0">
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Dashboard.ManagedCount, FallbackValue=–}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Managed applications" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Dashboard.RunningCount, FallbackValue=–}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Currently running" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Dashboard.BlockedCount, FallbackValue=–}" />
                        <TextBlock Style="{StaticResource Caption}" TextWrapping="Wrap">
                            <Run Text="Internet blocked" /><LineBreak /><Run Text="{Binding Dashboard.CustomCount, StringFormat='+ {0} custom allow-list', FallbackValue=''}" />
                        </TextBlock>
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Dashboard.AllowedCount, FallbackValue=–}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Allowed or not managed" />
                    </StackPanel>
                </Border>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource KpiValue}" Text="{Binding Dashboard.ErrorCount, FallbackValue=–}" Foreground="{DynamicResource StatusErrorBrush}" />
                        <TextBlock Style="{StaticResource Caption}" Text="Policy errors or degraded" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- Service and firewall -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Background service" />
                        <TextBlock Text="{Binding ServiceSummary}" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Windows Defender Firewall" />
                        <TextBlock Text="{Binding FirewallSummary}" TextWrapping="Wrap" />
                        <ItemsControl ItemsSource="{Binding Dashboard.Service.Firewall.Issues}" Margin="0,8,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarningBrush}" Margin="0,2" />
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>

            <!-- Applications table -->
            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Applications" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="No applications are managed yet. Use Application Discovery or Managed Applications → Add to get started."
                               Visibility="{Binding Dashboard.Applications, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                    <DataGrid x:Name="Apps" ItemsSource="{Binding Dashboard.Applications}" MaxHeight="420"
                              AutomationProperties.Name="Managed applications status"
                              Visibility="{Binding Dashboard.Applications, Converter={StaticResource NullToVisibility}}"
                              MouseDoubleClick="OnApplicationDoubleClick">
                        <DataGrid.Columns>
                            <DataGridTemplateColumn Header="Application" Width="2*" SortMemberPath="DisplayName">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                            <Image Source="{Binding PrimaryPath, Converter={StaticResource Icon}}" Width="20" Height="20" Margin="0,0,8,0" />
                                            <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTextColumn Header="Status" Width="*" Binding="{Binding IsRunning, Converter={StaticResource RunningText}}" />
                            <DataGridTextColumn Header="Network policy" Width="2*" Binding="{Binding EffectivePolicy, Converter={StaticResource PolicyText}}" />
                            <DataGridTemplateColumn Header="Enforcement" Width="2*" SortMemberPath="Enforcement.State" CellTemplate="{StaticResource EnforcementBadge}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition />
                    <ColumnDefinition />
                </Grid.ColumnDefinitions>
                <Border Style="{StaticResource Card}">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Recent policy changes" />
                        <TextBlock Style="{StaticResource Caption}" Text="No policy changes recorded."
                                   Visibility="{Binding Dashboard.RecentPolicyChanges, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Dashboard.RecentPolicyChanges}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock TextWrapping="Wrap"><Run Text="{Binding ApplicationName}" FontWeight="SemiBold" /> <Run Text="{Binding Message}" /></TextBlock>
                                        <TextBlock Style="{StaticResource Caption}">
                                            <Run Text="{Binding Timestamp, Converter={StaticResource LocalTime}, Mode=OneWay}" /> · <Run Text="{Binding Actor, Mode=OneWay}" />
                                        </TextBlock>
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
                <Border Grid.Column="1" Style="{StaticResource Card}">
                    <StackPanel>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="View all" Command="{Binding ShowFailuresCommand}" />
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Recent enforcement failures" />
                        </DockPanel>
                        <TextBlock Style="{StaticResource Caption}" Text="No failures recorded."
                                   Visibility="{Binding Dashboard.RecentFailures, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                        <ItemsControl ItemsSource="{Binding Dashboard.RecentFailures}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,4">
                                        <TextBlock TextWrapping="Wrap" Foreground="{DynamicResource StatusErrorBrush}">
                                            <Run Text="{Binding ApplicationName, Mode=OneWay}" FontWeight="SemiBold" /> <Run Text="{Binding Message, Mode=OneWay}" />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Caption}" Text="{Binding Timestamp, Converter={StaticResource LocalTime}}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

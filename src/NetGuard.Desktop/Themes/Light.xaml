<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Status colors meet WCAG AA contrast against the light card background. -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#0F7B0F" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#9D5D00" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#C42B1C" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#005FB8" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#616161" />
    <SolidColorBrush x:Key="WarningPanelBrush" Color="#FFF4CE" />
    <SolidColorBrush x:Key="ErrorPanelBrush" Color="#FDE7E9" />
    <SolidColorBrush x:Key="InfoPanelBrush" Color="#E5F1FB" />
</ResourceDictionary>

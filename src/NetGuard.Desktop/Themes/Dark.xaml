<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Status colors meet WCAG AA contrast against the dark card background. -->
    <SolidColorBrush x:Key="StatusSuccessBrush" Color="#6CCB5F" />
    <SolidColorBrush x:Key="StatusWarningBrush" Color="#FCE100" />
    <SolidColorBrush x:Key="StatusErrorBrush" Color="#FF99A4" />
    <SolidColorBrush x:Key="StatusInfoBrush" Color="#60CDFF" />
    <SolidColorBrush x:Key="StatusNeutralBrush" Color="#C5C5C5" />
    <SolidColorBrush x:Key="WarningPanelBrush" Color="#433519" />
    <SolidColorBrush x:Key="ErrorPanelBrush" Color="#442726" />
    <SolidColorBrush x:Key="InfoPanelBrush" Color="#1F3A4D" />
</ResourceDictionary>

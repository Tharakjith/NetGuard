<UserControl x:Class="NetGuard.Desktop.Views.FirewallView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="0,0,12,24">
            <TextBlock Style="{StaticResource PageTitle}" Text="Firewall Policies" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="What is actually configured in Windows Defender Firewall right now, read live. NetGuard only creates outbound block rules in the 'NetGuard Enterprise' group and only changes rules it owns." />
            <WrapPanel Margin="0,0,0,8">
                <Button Style="{DynamicResource AccentButtonStyle}" Content="Re-verify all rules" Command="{Binding ReverifyCommand}" Margin="0,0,8,8" />
                <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
            </WrapPanel>
            <Border Style="{StaticResource WarningPanel}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource InfoPanel}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" />
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Firewall status" />
                    <TextBlock Visibility="{Binding Overview.Status.Available, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}"
                               Text="{Binding Overview.Status.Error}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" />
                    <DataGrid ItemsSource="{Binding Overview.Status.Profiles}" Margin="0,4,0,8" AutomationProperties.Name="Firewall profiles">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Profile" Width="*" Binding="{Binding Profile}" />
                            <DataGridCheckBoxColumn Header="Firewall on" Width="*" Binding="{Binding Enabled, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="Current network" Width="*" Binding="{Binding IsCurrent, Mode=OneWay}" />
                            <DataGridCheckBoxColumn Header="Outbound blocked by default" Width="1.5*" Binding="{Binding DefaultOutboundBlocked, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                    <TextBlock>
                        Local policy state: <Run Text="{Binding Overview.Status.LocalPolicyModifyState, Mode=OneWay}" /> ·
                        <Run Text="{Binding Overview.Status.OwnedRuleCount, Mode=OneWay}" /> NetGuard rule(s) of <Run Text="{Binding Overview.Status.TotalRuleCount, Mode=OneWay}" />
                    </TextBlock>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,4,0,0" TextWrapping="Wrap">
                        Registered firewall products: <Run Text="{Binding Overview.Status.RegisteredFirewallProducts.Count, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Overview.Status.RegisteredFirewallProducts}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource Caption}" Text="{Binding StringFormat='• {0}'}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Overview.Status.Issues}" Margin="0,8,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarningBrush}" Margin="0,2" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="NetGuard rules" />
                    <DataGrid ItemsSource="{Binding Overview.OwnedRules}" MaxHeight="360" AutomationProperties.Name="NetGuard rules">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Width="*" Binding="{Binding ApplicationName}" />
                            <DataGridTextColumn Header="Program" Width="2*" Binding="{Binding ApplicationPath}" />
                            <DataGridTextColumn Header="Protocol" Width="80" Binding="{Binding Protocol}" />
                            <DataGridTextColumn Header="Remote addresses" Width="1.5*" Binding="{Binding RemoteAddresses}" />
                            <DataGridTextColumn Header="Remote ports" Width="*" Binding="{Binding RemotePorts}" />
                            <DataGridTextColumn Header="Profiles" Width="*" Binding="{Binding Profiles}" />
                            <DataGridCheckBoxColumn Header="Enabled" Width="70" Binding="{Binding Enabled, Mode=OneWay}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding Overview.Conflicts, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Conflicts" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6" Text="Configuration outside NetGuard that changes how managed applications are treated. NetGuard reports these but never modifies them." />
                    <DataGrid ItemsSource="{Binding Overview.Conflicts}" MaxHeight="300" AutomationProperties.Name="Conflicts">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Application" Width="*" Binding="{Binding ApplicationName}" />
                            <DataGridTextColumn Header="Rule" Width="*" Binding="{Binding RuleName}" />
                            <DataGridTextColumn Header="Explanation" Width="3*" Binding="{Binding Explanation}">
                                <DataGridTextColumn.ElementStyle>
                                    <Style TargetType="TextBlock"><Setter Property="TextWrapping" Value="Wrap" /></Style>
                                </DataGridTextColumn.ElementStyle>
                            </DataGridTextColumn>
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}" Visibility="{Binding Overview.OrphanedRules, Converter={StaticResource NullToVisibility}}">
                <StackPanel>
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Content="Remove orphaned rules…" Command="{Binding CleanupCommand}" />
                        <TextBlock Style="{StaticResource SectionTitle}" Text="Orphaned NetGuard rules" />
                    </DockPanel>
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,6"
                               Text="These rules carry NetGuard's marker but belong to no managed application (for example after restoring an older configuration). They are kept so nothing becomes unblocked by surprise; an administrator can remove them." />
                    <DataGrid ItemsSource="{Binding Overview.OrphanedRules}" MaxHeight="240">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Rule" Width="2*" Binding="{Binding Name}" />
                            <DataGridTextColumn Header="Program" Width="2*" Binding="{Binding ApplicationPath}" />
                            <DataGridTextColumn Header="Protocol" Width="*" Binding="{Binding Protocol}" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Style="{StaticResource SectionTitle}" Text="What program-based rules can and cannot do" />
                    <ItemsControl ItemsSource="{Binding Limitations}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Text="{Binding StringFormat='• {0}'}" TextWrapping="Wrap" Margin="0,3" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>

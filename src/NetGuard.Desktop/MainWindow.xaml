<Window x:Class="NetGuard.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:NetGuard.Desktop.ViewModels"
        xmlns:views="clr-namespace:NetGuard.Desktop.Views"
        Title="NetGuard Enterprise"
        Icon="Assets/netguard.ico"
        Width="1280" Height="820" MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}"><views:DashboardView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ApplicationsViewModel}"><views:ApplicationsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiscoveryViewModel}"><views:DiscoveryView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:FirewallViewModel}"><views:FirewallView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProfilesViewModel}"><views:ProfilesView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:LogsViewModel}"><views:LogsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:DiagnosticsViewModel}"><views:DiagnosticsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}"><views:SettingsView /></DataTemplate>
        <DataTemplate DataType="{x:Type vm:AboutViewModel}"><views:AboutView /></DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F5" Command="{Binding CurrentPage.RefreshCommand}" />
        <KeyBinding Key="D1" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="0" />
        <KeyBinding Key="D2" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="1" />
        <KeyBinding Key="D3" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="2" />
        <KeyBinding Key="D4" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="3" />
        <KeyBinding Key="D5" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="4" />
        <KeyBinding Key="D6" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="5" />
        <KeyBinding Key="D7" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="6" />
        <KeyBinding Key="D8" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="7" />
        <KeyBinding Key="D9" Modifiers="Control" Command="{Binding NavigateIndexCommand}" CommandParameter="8" />
    </Window.InputBindings>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="240" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Connection / permission banner -->
        <Border Grid.ColumnSpan="2" Padding="16,8" Background="{DynamicResource WarningPanelBrush}"
                Visibility="{Binding IsConnected, Converter={StaticResource BoolToVisibility}, ConverterParameter=invert}">
            <StackPanel Orientation="Horizontal">
                <TextBlock Style="{StaticResource IconGlyph}" Text="&#xE7BA;" Margin="0,0,8,0" />
                <TextBlock Text="{Binding ConnectionText}" VerticalAlignment="Center" TextWrapping="Wrap"
                           AutomationProperties.LiveSetting="Assertive" />
            </StackPanel>
        </Border>
        <Border Grid.ColumnSpan="2" Padding="16,8" Background="{DynamicResource InfoPanelBrush}"
                Visibility="{Binding ShowElevationHint, Converter={StaticResource BoolToVisibility}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Restart as administrator" Command="{Binding RestartElevatedCommand}"
                        AutomationProperties.Name="Restart NetGuard as administrator" />
                <TextBlock Text="{Binding PermissionText}" VerticalAlignment="Center" TextWrapping="Wrap" />
            </DockPanel>
        </Border>

        <!-- Navigation -->
        <DockPanel Grid.Row="1" Background="{DynamicResource SubtleFillColorSecondaryBrush}">
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="16,18,16,18">
                <Image Source="Assets/netguard.ico" Width="28" Height="28" Margin="0,0,10,0" />
                <StackPanel>
                    <TextBlock Text="NetGuard" FontSize="17" FontWeight="SemiBold" />
                    <TextBlock Text="Enterprise" Style="{StaticResource Caption}" />
                </StackPanel>
            </StackPanel>
            <TextBlock DockPanel.Dock="Bottom" Margin="16,8,16,12" Style="{StaticResource Caption}" Text="{Binding ConnectionText}" />
            <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding CurrentPage}" BorderThickness="0" Background="Transparent"
                     AutomationProperties.Name="Navigation" KeyboardNavigation.TabNavigation="Once">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Orientation="Horizontal" Margin="4,6" AutomationProperties.Name="{Binding Title}">
                            <TextBlock Style="{StaticResource IconGlyph}" Text="{Binding Glyph}" Margin="0,0,12,0" />
                            <TextBlock Text="{Binding Title}" VerticalAlignment="Center" />
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>

        <!-- Page -->
        <ContentControl Grid.Row="1" Grid.Column="1" Content="{Binding CurrentPage}" Focusable="False" Margin="24,20,12,0" />
    </Grid>
</Window>

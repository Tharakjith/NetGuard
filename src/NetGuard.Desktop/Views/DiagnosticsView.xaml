<UserControl x:Class="NetGuard.Desktop.Views.DiagnosticsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Diagnostics" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Service health, observations about how managed applications communicate, and a report you can attach to a support request." />
        </StackPanel>
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,0,0,12">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionTitle}" Text="Service" />
                <TextBlock Text="{Binding ServiceText}" TextWrapping="Wrap" />
            </StackPanel>
        </Border>
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,0,0,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Top">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Observations" />
                    <TextBlock Style="{StaticResource Caption}" Margin="0,0,0,8"
                               Text="Helper processes, relocations, identity changes and blocked attempts seen since the service started. Use these to find programs that communicate on an application's behalf." />
                </StackPanel>
                <DataGrid ItemsSource="{Binding Observations}" AutomationProperties.Name="Observations">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Last seen" Width="140" Binding="{Binding Timestamp, Converter={StaticResource LocalTime}, ConverterParameter='G'}" />
                        <DataGridTextColumn Header="Kind" Width="120" Binding="{Binding Kind}" />
                        <DataGridTextColumn Header="Application" Width="140" Binding="{Binding ApplicationName}" />
                        <DataGridTextColumn Header="Count" Width="60" Binding="{Binding Count}" />
                        <DataGridTextColumn Header="Executable" Width="*" Binding="{Binding ExecutablePath}" />
                        <DataGridTextColumn Header="Detail" Width="2*" Binding="{Binding Detail}" />
                    </DataGrid.Columns>
                </DataGrid>
            </DockPanel>
        </Border>
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0">
            <DockPanel>
                <WrapPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                    <TextBlock Style="{StaticResource SectionTitle}" Text="Diagnostic report" Margin="0,0,16,0" VerticalAlignment="Center" />
                    <CheckBox Content="Redact user names, profile paths and computer name" IsChecked="{Binding Redact}" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Button Style="{DynamicResource AccentButtonStyle}" Content="Generate" Command="{Binding GenerateCommand}" Margin="0,0,8,0" />
                    <Button Content="Save…" Command="{Binding SaveCommand}" />
                </WrapPanel>
                <TextBlock DockPanel.Dock="Top" Text="{Binding ErrorMessage}" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap"
                           Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}" />
                <TextBlock DockPanel.Dock="Top" Text="{Binding StatusMessage}" Style="{StaticResource Caption}"
                           Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}" />
                <TextBox Text="{Binding ReportText, Mode=OneWay}" IsReadOnly="True" FontFamily="Cascadia Mono, Consolas" FontSize="12"
                         VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="Diagnostic report" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>

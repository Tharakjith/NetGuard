<Window x:Class="NetGuard.Desktop.Views.ExceptionDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Temporary network exception" Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" ResizeMode="NoResize">
    <StackPanel Margin="20">
        <TextBlock x:Name="Intro" TextWrapping="Wrap" Margin="0,0,0,12" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Duration" Margin="0,0,0,2" />
        <ComboBox x:Name="Duration" DisplayMemberPath="Label" SelectedIndex="1" AutomationProperties.Name="Duration" />
        <TextBlock Style="{StaticResource FieldLabel}" Text="Reason (recorded in the audit log)" />
        <TextBox x:Name="Reason" MaxLength="500" TextWrapping="Wrap" AcceptsReturn="False" AutomationProperties.Name="Reason" />
        <TextBlock x:Name="Error" Foreground="{DynamicResource StatusErrorBrush}" TextWrapping="Wrap" Margin="0,6,0,0" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Style="{DynamicResource AccentButtonStyle}" Content="Grant exception" IsDefault="True" Click="OnGrant" Margin="0,0,8,0" MinWidth="120" />
            <Button Content="Cancel" IsCancel="True" MinWidth="90" />
        </StackPanel>
    </StackPanel>
</Window>

<UserControl x:Class="NetGuard.Desktop.Views.DiscoveryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,12,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="2*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel>
            <TextBlock Style="{StaticResource PageTitle}" Text="Application Discovery" />
            <TextBlock Style="{StaticResource PageSubtitle}"
                       Text="Finds installed desktop applications (per-machine and per-user uninstall entries, App Paths) and running processes. Discovery only reads information; it never changes anything." />
        </StackPanel>
        <WrapPanel Grid.Row="1" Margin="0,0,0,8">
            <Button Style="{DynamicResource AccentButtonStyle}" Content="Scan" Command="{Binding ScanCommand}" Margin="0,0,8,8" />
            <Button Content="Browse for an executable…" Command="{Binding BrowseCommand}" Margin="0,0,8,8" />
            <TextBox Width="240" Margin="0,0,12,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" AutomationProperties.Name="Search discovered applications" />
            <CheckBox Content="Include running processes" IsChecked="{Binding IncludeRunningProcesses}" Margin="0,0,12,8" VerticalAlignment="Center" />
            <CheckBox Content="Include Windows components" IsChecked="{Binding IncludeSystemComponents}" Margin="0,0,12,8" VerticalAlignment="Center" />
            <CheckBox Content="Hide already managed" IsChecked="{Binding HideManaged}" Margin="0,0,12,8" VerticalAlignment="Center" />
        </WrapPanel>
        <StackPanel Grid.Row="2">
            <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary}" Margin="0,0,0,8" />
            <Border Style="{StaticResource WarningPanel}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <ProgressBar IsIndeterminate="True" Height="4" Margin="0,0,0,8" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>
        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Discovered applications">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Application" Width="2*" SortMemberPath="Name">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding Executables[0].Path, Converter={StaticResource Icon}}" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding Name}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Publisher" Width="1.4*" Binding="{Binding Publisher}" />
                <DataGridTextColumn Header="Version" Width="*" Binding="{Binding Version}" />
                <DataGridCheckBoxColumn Header="Running" Width="70" Binding="{Binding IsRunning, Mode=OneWay}" />
                <DataGridCheckBoxColumn Header="Managed" Width="75" Binding="{Binding IsManaged, Mode=OneWay}" />
                <DataGridCheckBoxColumn Header="Possible duplicate" Width="120" Binding="{Binding IsPossibleDuplicate, Mode=OneWay}" />
            </DataGrid.Columns>
        </DataGrid>
        <DockPanel Grid.Row="4" Margin="0,12,0,6">
            <Button DockPanel.Dock="Right" Style="{DynamicResource AccentButtonStyle}" Content="Manage selected application…" Command="{Binding ManageCommand}" />
            <TextBlock Style="{StaticResource SectionTitle}" Text="Executables of the selected application" VerticalAlignment="Center" />
        </DockPanel>
        <Border Grid.Row="5" Style="{StaticResource Card}" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Selected.InstallLocation, StringFormat='Install location: {0}', TargetNullValue='Install location unknown'}" />
                    <TextBlock Style="{StaticResource Caption}">
                        <Run Text="Sources: " /><Run Text="{Binding Selected.Sources.Count, Mode=OneWay}" />
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding Selected.Sources}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate><TextBlock Style="{StaticResource Caption}" Text="{Binding StringFormat='• {0}'}" /></DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <ItemsControl ItemsSource="{Binding Selected.Executables}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <TextBlock TextWrapping="Wrap" Margin="0,2" FontFamily="Cascadia Mono, Consolas" FontSize="12">
                                    <Run Text="{Binding Path, Mode=OneWay}" />
                                    <Run Text="{Binding IsRunning, Converter={StaticResource RunningText}, StringFormat=' ({0})', Mode=OneWay}" />
                                </TextBlock>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>
        </Border>
    </Grid>
</UserControl>

<UserControl x:Class="NetGuard.Desktop.Views.ApplicationsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Grid Margin="0,0,0,12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="3*" MinWidth="380" />
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="2*" MinWidth="340" />
        </Grid.ColumnDefinitions>

        <StackPanel Grid.ColumnSpan="3">
            <TextBlock Style="{StaticResource PageTitle}" Text="Managed Applications" />
            <TextBlock Style="{StaticResource PageSubtitle}" Text="Applications whose network access NetGuard controls. Policies are enforced by the background service whether or not this window is open." />
        </StackPanel>

        <WrapPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,0,0,8">
            <Button Style="{DynamicResource AccentButtonStyle}" Content="Add application…" Command="{Binding AddCommand}" Margin="0,0,8,8"
                    ToolTip="Select an executable to manage" />
            <TextBox Width="240" Margin="0,0,8,8" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     AutomationProperties.Name="Search applications" ToolTip="Search by name, publisher or path" />
            <ComboBox Width="150" Margin="0,0,8,8" ItemsSource="{Binding PolicyFilters}" SelectedItem="{Binding PolicyFilter}" AutomationProperties.Name="Filter by policy" />
            <ComboBox Width="150" Margin="0,0,8,8" ItemsSource="{Binding StateFilters}" SelectedItem="{Binding StateFilter}" AutomationProperties.Name="Filter by enforcement state" />
            <Button Content="Re-verify all" Command="{Binding ReverifyCommand}" Margin="0,0,8,8" ToolTip="Read all rules back from the firewall and correct any drift" />
            <Button Content="Refresh" Command="{Binding RefreshCommand}" Margin="0,0,8,8" />
        </WrapPanel>

        <StackPanel Grid.Row="2" Grid.ColumnSpan="3">
            <Border Style="{StaticResource WarningPanel}" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding ErrorMessage}" TextWrapping="Wrap" />
            </Border>
            <Border Style="{StaticResource InfoPanel}" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVisibility}}">
                <TextBlock Text="{Binding StatusMessage}" TextWrapping="Wrap" AutomationProperties.LiveSetting="Polite" />
            </Border>
        </StackPanel>

        <DataGrid Grid.Row="3" ItemsSource="{Binding Items}" SelectedItem="{Binding Selected}" AutomationProperties.Name="Managed applications">
            <DataGrid.Columns>
                <DataGridTemplateColumn Header="Application" Width="2*" SortMemberPath="DisplayName">
                    <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <Image Source="{Binding PrimaryPath, Converter={StaticResource Icon}}" Width="20" Height="20" Margin="0,0,8,0" />
                                <TextBlock Text="{Binding DisplayName}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </DataTemplate>
                    </DataGridTemplateColumn.CellTemplate>
                </DataGridTemplateColumn>
                <DataGridTextColumn Header="Status" Width="80" Binding="{Binding IsRunning, Converter={StaticResource RunningText}}" SortMemberPath="IsRunning" />
                <DataGridTextColumn Header="Network policy" Width="1.5*" Binding="{Binding EffectivePolicy, Converter={StaticResource PolicyText}}" SortMemberPath="EffectivePolicy.Mode" />
                <DataGridTemplateColumn Header="Enforcement" Width="1.6*" SortMemberPath="Enforcement.State" CellTemplate="{StaticResource EnforcementBadge}" />
            </DataGrid.Columns>
        </DataGrid>

        <GridSplitter Grid.Row="3" Grid.Column="1" Width="6" HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="Transparent" Focusable="False" />

        <!-- Detail pane -->
        <ScrollViewer Grid.Row="3" Grid.Column="2" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="6,0,8,0">
                <TextBlock Style="{StaticResource Caption}" Text="Select an application to see its details."
                           Visibility="{Binding Detail, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                <StackPanel DataContext="{Binding Detail}" Visibility="{Binding Converter={StaticResource NullToVisibility}}">
                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <Image Source="{Binding Summary.PrimaryPath, Converter={StaticResource Icon}}" Width="32" Height="32" Margin="0,0,12,0" />
                                <StackPanel>
                                    <TextBlock Text="{Binding Summary.DisplayName}" FontSize="18" FontWeight="SemiBold" TextWrapping="Wrap" />
                                    <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary.Publisher, TargetNullValue='Unknown publisher'}" />
                                </StackPanel>
                            </StackPanel>

                            <Border Style="{StaticResource InfoPanel}" Margin="0,12,0,0"
                                    Visibility="{Binding DataContext.IsOrganizationManaged, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Text="Managed by organization policy. Changes must be made in the organization policy file by an administrator." />
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Enforcement" />
                            <StackPanel Orientation="Horizontal">
                                <Ellipse Width="10" Height="10" Margin="0,0,6,0" Fill="{Binding Summary.Enforcement.State, Converter={StaticResource EnforcementBrush}}" />
                                <TextBlock Text="{Binding Summary.Enforcement.State, Converter={StaticResource EnforcementText}}" FontWeight="SemiBold" />
                            </StackPanel>
                            <TextBlock Text="{Binding Summary.Enforcement.Message}" TextWrapping="Wrap" Margin="0,4,0,0" />
                            <TextBlock Style="{StaticResource Caption}" Margin="0,2,0,0"
                                       Text="{Binding Summary.Enforcement.LastVerifiedAt, Converter={StaticResource LocalTime}, StringFormat='Last verified {0}', TargetNullValue='Not verified yet'}" />
                            <ItemsControl ItemsSource="{Binding Summary.Enforcement.Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat='⚠ {0}'}" TextWrapping="Wrap" Foreground="{DynamicResource StatusWarningBrush}" Margin="0,4,0,0" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Border Style="{StaticResource InfoPanel}" Margin="0,8,0,0"
                                    Visibility="{Binding DataContext.ExceptionText, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource NullToVisibility}}">
                                <TextBlock TextWrapping="Wrap" Text="{Binding DataContext.ExceptionText, RelativeSource={RelativeSource AncestorType=UserControl}}" />
                            </Border>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Network policy" />
                            <TextBlock Text="{Binding Summary.EffectivePolicy, Converter={StaticResource PolicyText}}" />
                            <TextBlock Style="{StaticResource Caption}" Text="{Binding Summary.ProfileName, StringFormat='Profile: {0}'}"
                                       Visibility="{Binding Summary.ProfileName, Converter={StaticResource NullToVisibility}}" />
                            <TextBlock Style="{StaticResource Caption}" Text="The enabled profile's policy overrides this application's own policy."
                                       Visibility="{Binding Summary.ProfileOverridesPolicy, Converter={StaticResource BoolToVisibility}}" />

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Process state" />
                            <TextBlock>
                                <Run Text="{Binding Summary.IsRunning, Converter={StaticResource RunningText}, Mode=OneWay}" />
                                <Run Text="{Binding Summary.RunningInstances, StringFormat='({0} instance(s))', Mode=OneWay}" />
                            </TextBlock>

                            <TextBlock Style="{StaticResource FieldLabel}" Text="Created / modified" />
                            <TextBlock TextWrapping="Wrap">
                                <Run Text="{Binding Summary.CreatedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" /> by <Run Text="{Binding Application.CreatedBy, Mode=OneWay}" />
                                <LineBreak />
                                <Run Text="{Binding Summary.ModifiedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" /> by <Run Text="{Binding Application.ModifiedBy, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </Border>

                    <!-- Actions -->
                    <WrapPanel Margin="0,0,0,12" DataContext="{Binding DataContext, RelativeSource={RelativeSource AncestorType=UserControl}}">
                        <Button Style="{DynamicResource AccentButtonStyle}" Content="Edit policy…" Command="{Binding EditCommand}" Margin="0,0,8,8" />
                        <Button Content="{Binding EnableButtonText}" Command="{Binding ToggleEnabledCommand}" Margin="0,0,8,8" />
                        <Button Content="Temporary exception…" Command="{Binding GrantExceptionCommand}" Margin="0,0,8,8"
                                ToolTip="Allow network access for a limited time; the restriction returns automatically" />
                        <Button Content="End exception" Command="{Binding RevokeExceptionCommand}" Margin="0,0,8,8" />
                        <Button Content="Restore previous state…" Command="{Binding RestoreCommand}" Margin="0,0,8,8"
                                ToolTip="Remove only NetGuard's rules for this application and disable management" />
                        <Button Content="Remove…" Command="{Binding RemoveCommand}" Margin="0,0,8,8" />
                        <Button Content="View logs" Command="{Binding ViewLogsCommand}" Margin="0,0,8,8" />
                        <Button Content="Show in folder" Command="{Binding OpenFolderCommand}" Margin="0,0,8,8" />
                    </WrapPanel>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Executables" />
                            <ItemsControl ItemsSource="{Binding Application.Executables}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock Text="{Binding Path}" TextWrapping="Wrap" FontFamily="Cascadia Mono, Consolas" FontSize="12" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Origin, Mode=OneWay}" /> · version <Run Text="{Binding FileVersion, Mode=OneWay, TargetNullValue='unknown'}" /> · signature: <Run Text="{Binding SignatureStatus, Mode=OneWay}" />
                                            </TextBlock>
                                            <TextBlock Style="{StaticResource Caption}" Text="{Binding SignerSubject}" Visibility="{Binding SignerSubject, Converter={StaticResource NullToVisibility}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding RunningProcesses, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Running processes" />
                            <ItemsControl ItemsSource="{Binding RunningProcesses}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock TextWrapping="Wrap" Margin="0,2">
                                            PID <Run Text="{Binding ProcessId, Mode=OneWay}" /> · started <Run Text="{Binding StartedAt, Converter={StaticResource LocalTime}, Mode=OneWay}" />
                                        </TextBlock>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="NetGuard firewall rules (read from Windows)" />
                            <TextBlock Style="{StaticResource Caption}" Text="No NetGuard rules exist for this application right now."
                                       Visibility="{Binding Rules, Converter={StaticResource NullToVisibility}, ConverterParameter=invert}" />
                            <ItemsControl ItemsSource="{Binding Rules}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding Name}" TextWrapping="Wrap" FontWeight="SemiBold" />
                                            <TextBlock Style="{StaticResource Caption}">
                                                <Run Text="{Binding Direction, Mode=OneWay}" /> · <Run Text="{Binding Action, Mode=OneWay}" /> · <Run Text="{Binding Protocol, Mode=OneWay}" /> · remote <Run Text="{Binding RemoteAddresses, Mode=OneWay}" /> ports <Run Text="{Binding RemotePorts, Mode=OneWay}" /> · <Run Text="{Binding Profiles, Mode=OneWay}" />
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Conflicts, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Conflicts with other firewall configuration" />
                            <ItemsControl ItemsSource="{Binding Conflicts}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock Text="{Binding RuleName}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Text="{Binding Explanation}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}" Margin="0,0,0,12" Visibility="{Binding Observations, Converter={StaticResource NullToVisibility}}">
                        <StackPanel>
                            <TextBlock Style="{StaticResource SectionTitle}" Text="Observations" />
                            <ItemsControl ItemsSource="{Binding Observations}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="0,0,0,8">
                                            <TextBlock TextWrapping="Wrap"><Run Text="{Binding Kind, Mode=OneWay}" FontWeight="SemiBold" /> · <Run Text="{Binding ExecutablePath, Mode=OneWay}" /></TextBlock>
                                            <TextBlock Text="{Binding Detail}" TextWrapping="Wrap" Style="{StaticResource Caption}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</UserControl>
